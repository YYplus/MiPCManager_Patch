import {
    Button,
    LineEdit,
    TextEdit,
    ComboBox,
    Spinner,
    ScrollView,
    CheckBox,
    RadioGroup,
    Palette,
} from "std-widgets.slint";

import "MiSans-Regular.ttf";

export component AppWindow inherits Window {
    title: "MiPCM Patch";
    icon: @image-url("MiPCManager.png");
    default-font-family: "MiSans";
    default-font-size: 14px;
    preferred-width: 1280px;
    preferred-height: 720px;
    min-width: 1100px;
    min-height: 720px;

    in-out property <string> log-text;
    in-out property <bool> state-ready: false;
    in-out property <bool> state-refreshing: false;
    in-out property <int> state-generation: 0;
    in-out property <bool> operation-busy: false;
    private property <bool> controls-ready: root.state-ready && !root.operation-busy && !root.downloading && !root.xiaoai-busy;
    in-out property <bool> full-features: false;
    in-out property <bool> continuity-available: false;
    in-out property <bool> xiaoai-available: false;
    in-out property <bool> locale-active: false;
    in-out property <bool> device-active: false;
    in-out property <bool> camera-active: false;
    in-out property <bool> audio-active: false;
    in-out property <int> audio-mode: 0;
    in-out property <bool> xiaoai-patch-active: false;
    in-out property <int> dual-nic-state: 0;
    in-out property <bool> smbios-active: false;
    // 0=disabled, 1=enabled, 2=partial/repairable
    in-out property <int> share-menu-state: 0;
    in-out property <bool> share-menu-busy: false;
    in-out property <string> last-error;
    in-out property <length> log-viewport-y: 0px;
    in-out property <bool> downloading: false;
    in-out property <bool> xiaoai-busy: false;
    in-out property <bool> manager-manual: false;
    in-out property <bool> continuity-manual: false;
    in-out property <bool> xiaoai-manual: false;
    in-out property <[string]> manager-sources;
    in-out property <[string]> manager-requirements;
    in-out property <int> manager-source-idx: 0;
    in-out property <int> continuity-source-idx: 0;
    in-out property <string> xiaoai-source;
    in-out property <float> manager-progress: 0;
    in-out property <string> manager-progress-text;
    in-out property <bool> manager-download-active: false;
    in-out property <float> xiaoai-progress: 0;
    in-out property <string> xiaoai-progress-text;
    in-out property <bool> xiaoai-download-active: false;
    in-out property <bool> show-confirm: false;
    in-out property <int> confirm-product: 0;
    in-out property <string> confirm-desc;
    in-out property <string> manager-url-input;
    in-out property <string> manager-path-input;
    in-out property <string> continuity-url-input;
    in-out property <string> continuity-path-input;
    in-out property <string> xiaoai-url-input;
    in-out property <string> xiaoai-path-input;
    in-out property <string> custom-model-input: "TM2425";
    in-out property <[string]> model-presets;
    in-out property <[string]> model-codes;
    in-out property <int> model-idx: 0;
    in-out property <bool> custom-mode: false;

    pure callback tr(string) -> string;

    callback refresh();
    callback apply-locale();
    callback revert-locale();
    callback apply-device(string);
    callback revert-device();
    callback apply-camera();
    callback revert-camera();
    callback apply-audio-wifi();
    callback apply-audio-lan();
    callback revert-audio();
    callback diagnose-dual-nic();
    callback fix-dual-nic();
    callback apply-smbios(string);
    callback revert-smbios();
    callback apply-xiaoai();
    callback revert-xiaoai();
    callback apply-xiaomi-share-menu();
    callback revert-xiaomi-share-menu();
    callback install-recommended();
    callback install-recommended-xiaoai();
    callback cancel-download();
    callback cancel-xiaoai-download();
    callback download-and-install-manager(string);
    callback browse-manager-installer();
    callback start-manager-install(string);
    callback download-and-install-continuity(string);
    callback browse-continuity-installer();
    callback start-continuity-install(string);
    callback download-and-install-xiaoai(string);
    callback browse-xiaoai-installer();
    callback start-xiaoai-install(string);
    callback uninstall-msix();
    callback request-uninstall(int);
    callback request-xiaoai-uninstall();
    callback confirm-uninstall();
    callback cancel-uninstall();
    callback clear-log();

    VerticalLayout {
        padding: 12px;
        spacing: 8px;

        HorizontalLayout {
            spacing: 8px;
            Text {
                text: root.tr("app.title");
                font-size: 24px;
                font-weight: 700;
                vertical-alignment: center;
            }
            HorizontalLayout {
                alignment: end;
                Button { height: 30px; width: 80px; text: root.tr("btn.refresh"); clicked => { root.refresh(); } }
            }
        }

        HorizontalLayout {
            spacing: 12px;

            VerticalLayout {
                min-width: 320px;
                preferred-width: 360px;
                max-width: 360px;
                Rectangle {
                    border-radius: 10px;
                    border-width: 1px;
                    vertical-stretch: 1;
                    VerticalLayout {
                        padding: 16px;
                        spacing: 8px;
                        HorizontalLayout {
                            Text { text: root.tr("gui.log.title"); font-weight: 700; font-size: 16px; vertical-alignment: center; }
                            HorizontalLayout {
                                alignment: end;
                                Button { height: 30px; width: 80px; text: root.tr("btn.clear-log"); clicked => { root.clear-log(); } }
                            }
                        }
                        if root.last-error != "": Text { text: root.tr("gui.warn.recent_error") + root.last-error; color: #dc3730; font-size: 16px; }
                        TextEdit { text <=> root.log-text; read-only: true; min-height: 100px; vertical-stretch: 1; viewport-y <=> root.log-viewport-y; }
                    }
                }
            }

            ScrollView {
                VerticalLayout {
                    alignment: start;
                    spacing: 10px;

                    Rectangle {
                        border-radius: 10px;
                        border-width: 1px;
                        VerticalLayout {
                            padding: 16px;
                            spacing: 8px;

                            Rectangle {
                                min-height: 54px;
                                max-height: 54px;
                                HorizontalLayout {
                                    spacing: 12px;
                                    VerticalLayout {
                                        alignment: center;
                                        min-width: 210px; preferred-width: 210px; max-width: 210px;
                                        Text { text: root.tr("install.row.manager"); font-size: 16px; vertical-alignment: center; }
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        min-width: 128px; preferred-width: 128px; max-width: 128px;
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        HorizontalLayout {
                                            alignment: end;
                                            spacing: 8px;
                                            Button { height: 34px; width: 112px; primary: true; text: root.tr("install.one-click"); enabled: root.controls-ready && !root.downloading && !root.full-features && !root.continuity-available; clicked => { root.manager-source-idx = 0; root.install-recommended(); } }
                                            Button { height: 34px; width: 112px; text: root.tr("install.manual"); enabled: root.controls-ready && !root.downloading && !root.full-features && !root.continuity-available; clicked => { root.continuity-manual = false; root.xiaoai-manual = false; root.manager-manual = !root.manager-manual; } }
                                            Button { height: 34px; width: 72px; text: root.tr("section.uninstall"); enabled: root.controls-ready && root.full-features && !root.downloading; clicked => { root.request-uninstall(0); } }
                                            Rectangle { width: 20px; height: 20px; if root.downloading && root.manager-source-idx == 0: Spinner { indeterminate: true; } }
                                        }
                                    }
                                }
                            }

                            if root.manager-manual: VerticalLayout {
                                spacing: 6px;
                                HorizontalLayout {
                                    spacing: 6px;
                                    LineEdit { text <=> root.manager-url-input; enabled: root.controls-ready && !root.full-features && !root.continuity-available && !root.downloading; placeholder-text: root.tr("install.download.placeholder"); }
                                    Button { height: 30px; width: 166px; primary: true; text: root.tr("install.download.and.install"); enabled: root.controls-ready && !root.full-features && !root.continuity-available && !root.downloading && root.manager-url-input != ""; clicked => { root.download-and-install-manager(root.manager-url-input); } }
                                }
                                HorizontalLayout {
                                    spacing: 6px;
                                    LineEdit { text <=> root.manager-path-input; enabled: root.controls-ready && !root.full-features && !root.continuity-available && !root.downloading; placeholder-text: root.tr("install.file.placeholder"); }
                                    Button { height: 30px; width: 80px; text: root.tr("btn.select"); enabled: root.controls-ready && !root.full-features && !root.continuity-available && !root.downloading; clicked => { root.browse-manager-installer(); } }
                                    Button { height: 30px; width: 80px; primary: true; text: root.tr("btn.start-install"); enabled: root.controls-ready && !root.full-features && !root.continuity-available && !root.downloading && root.manager-path-input != ""; clicked => { root.start-manager-install(root.manager-path-input); } }
                                }
                            }

                            Rectangle {
                                min-height: 54px;
                                max-height: 54px;
                                HorizontalLayout {
                                    spacing: 12px;
                                    VerticalLayout {
                                        alignment: center;
                                        min-width: 210px; preferred-width: 210px; max-width: 210px;
                                        Text { text: root.tr("install.row.continuity"); font-size: 16px; vertical-alignment: center; }
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        min-width: 128px; preferred-width: 128px; max-width: 128px;
                                        RadioGroup {
                                            min-width: 104px; preferred-width: 104px; max-width: 104px;
                                            orientation: horizontal;
                                            enabled: root.controls-ready && !root.downloading && !root.full-features && !root.continuity-available;
                                            RadioButton { text: "OS3"; checked: root.continuity-source-idx == 0; }
                                            RadioButton { text: "OS4"; checked: root.continuity-source-idx == 1; }
                                            selected(value) => { root.continuity-source-idx = value == "OS4" ? 1 : 0; }
                                        }
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        HorizontalLayout {
                                            alignment: end;
                                            spacing: 8px;
                                            Button { height: 34px; width: 112px; primary: true; text: root.tr("install.one-click"); enabled: root.controls-ready && !root.downloading && !root.full-features && !root.continuity-available; clicked => { root.manager-source-idx = root.continuity-source-idx + 1; root.install-recommended(); } }
                                            Button { height: 34px; width: 112px; text: root.tr("install.manual"); enabled: root.controls-ready && !root.downloading && !root.full-features && !root.continuity-available; clicked => { root.manager-manual = false; root.xiaoai-manual = false; root.continuity-manual = !root.continuity-manual; } }
                                            Button { height: 34px; width: 72px; text: root.tr("section.uninstall"); enabled: root.controls-ready && root.continuity-available && !root.downloading; clicked => { root.request-uninstall(1); } }
                                            Rectangle { width: 20px; height: 20px; if root.downloading && root.manager-source-idx != 0: Spinner { indeterminate: true; } }
                                        }
                                    }
                                }
                            }

                            if root.continuity-manual: VerticalLayout {
                                spacing: 6px;
                                HorizontalLayout {
                                    spacing: 6px;
                                    LineEdit { text <=> root.continuity-url-input; enabled: root.controls-ready && !root.full-features && !root.continuity-available && !root.downloading; placeholder-text: root.tr("install.download.placeholder"); }
                                    Button { height: 30px; width: 166px; primary: true; text: root.tr("install.download.and.install"); enabled: root.controls-ready && !root.full-features && !root.continuity-available && !root.downloading && root.continuity-url-input != ""; clicked => { root.download-and-install-continuity(root.continuity-url-input); } }
                                }
                                HorizontalLayout {
                                    spacing: 6px;
                                    LineEdit { text <=> root.continuity-path-input; enabled: root.controls-ready && !root.full-features && !root.continuity-available && !root.downloading; placeholder-text: root.tr("install.file.placeholder"); }
                                    Button { height: 30px; width: 80px; text: root.tr("btn.select"); enabled: root.controls-ready && !root.full-features && !root.continuity-available && !root.downloading; clicked => { root.browse-continuity-installer(); } }
                                    Button { height: 30px; width: 80px; primary: true; text: root.tr("btn.start-install"); enabled: root.controls-ready && !root.full-features && !root.continuity-available && !root.downloading && root.continuity-path-input != ""; clicked => { root.start-continuity-install(root.continuity-path-input); } }
                                }
                            }

                            Rectangle {
                                min-height: 54px;
                                max-height: 54px;
                                HorizontalLayout {
                                    spacing: 12px;
                                    VerticalLayout {
                                        alignment: center;
                                        min-width: 210px; preferred-width: 210px; max-width: 210px;
                                        Text { text: root.tr("install.row.xiaoai"); font-size: 16px; vertical-alignment: center; }
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        min-width: 128px; preferred-width: 128px; max-width: 128px;
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        HorizontalLayout {
                                            alignment: end;
                                            spacing: 8px;
                                            Button { height: 34px; width: 112px; primary: true; text: root.tr("install.one-click"); enabled: root.controls-ready && !root.xiaoai-busy && !root.xiaoai-available; clicked => { root.install-recommended-xiaoai(); } }
                                            Button { height: 34px; width: 112px; text: root.tr("install.manual"); enabled: root.controls-ready && !root.xiaoai-busy && !root.xiaoai-available; clicked => { root.manager-manual = false; root.continuity-manual = false; root.xiaoai-manual = !root.xiaoai-manual; } }
                                            Button { height: 34px; width: 72px; text: root.tr("section.uninstall"); enabled: root.controls-ready && root.xiaoai-available && !root.xiaoai-busy; clicked => { root.request-xiaoai-uninstall(); } }
                                            Rectangle { width: 20px; height: 20px; if root.xiaoai-busy: Spinner { indeterminate: true; } }
                                        }
                                    }
                                }
                            }

                            if root.xiaoai-manual: VerticalLayout {
                                spacing: 6px;
                                HorizontalLayout {
                                    spacing: 6px;
                                    LineEdit { text <=> root.xiaoai-url-input; enabled: root.controls-ready && !root.xiaoai-available && !root.xiaoai-busy; placeholder-text: root.tr("install.download.placeholder"); }
                                    Button { height: 30px; width: 166px; primary: true; text: root.tr("install.download.and.install"); enabled: root.controls-ready && !root.xiaoai-available && !root.xiaoai-busy && root.xiaoai-url-input != ""; clicked => { root.download-and-install-xiaoai(root.xiaoai-url-input); } }
                                }
                                HorizontalLayout {
                                    spacing: 6px;
                                    LineEdit { text <=> root.xiaoai-path-input; enabled: root.controls-ready && !root.xiaoai-available && !root.xiaoai-busy; placeholder-text: root.tr("install.file.placeholder"); }
                                    Button { height: 30px; width: 80px; text: root.tr("btn.select"); enabled: root.controls-ready && !root.xiaoai-available && !root.xiaoai-busy; clicked => { root.browse-xiaoai-installer(); } }
                                    Button { height: 30px; width: 80px; primary: true; text: root.tr("btn.start-install"); enabled: root.controls-ready && !root.xiaoai-available && !root.xiaoai-busy && root.xiaoai-path-input != ""; clicked => { root.start-xiaoai-install(root.xiaoai-path-input); } }
                                }
                            }

                            if root.downloading: VerticalLayout {
                                spacing: 6px;
                                Rectangle {
                                    height: 6px;
                                    background: Palette.alternate-background;
                                    Rectangle { width: parent.width * root.manager-progress; background: Palette.accent-background; }
                                }
                                Text { text: root.manager-progress-text; }
                                Button { height: 30px; text: root.tr("install.cancel-download"); enabled: root.manager-download-active; clicked => { root.cancel-download(); } }
                            }

                            if root.xiaoai-busy: VerticalLayout {
                                spacing: 6px;
                                Rectangle {
                                    height: 6px;
                                    background: Palette.alternate-background;
                                    Rectangle { width: parent.width * root.xiaoai-progress; background: Palette.accent-background; }
                                }
                                Text { text: root.xiaoai-progress-text; }
                                Button { height: 30px; text: root.tr("install.cancel-download"); enabled: root.xiaoai-download-active; clicked => { root.cancel-xiaoai-download(); } }
                            }
                        }
                    }

                    Rectangle {
                        border-radius: 10px;
                        border-width: 1px;
                        VerticalLayout {
                            padding: 16px;
                            spacing: 10px;
                            Text { text: root.tr("section.patches"); font-weight: 700; font-size: 16px; }

                            HorizontalLayout {
                                min-height: 40px;
                                spacing: 10px;
                                Text { text: root.tr("patch.locale"); vertical-alignment: center; min-width: 150px; preferred-width: 150px; max-width: 150px; font-size: 16px; }
                                HorizontalLayout {
                                    alignment: end;
                                    spacing: 6px;
                                    Button { height: 30px; width: 80px; primary: true; text: root.tr("btn.apply"); enabled: root.controls-ready && (root.full-features || root.continuity-available) && !root.locale-active; clicked => { root.apply-locale(); } }
                                    Button { height: 30px; width: 80px; text: root.tr("btn.revert"); enabled: root.controls-ready && (root.full-features || root.continuity-available) && root.locale-active; clicked => { root.revert-locale(); } }
                                }
                            }

                            HorizontalLayout {
                                min-height: 40px;
                                spacing: 10px;
                                Text { text: root.tr("patch.device"); vertical-alignment: center; min-width: 150px; preferred-width: 150px; max-width: 150px; font-size: 16px; }
                                HorizontalLayout {
                                    alignment: end;
                                    spacing: 6px;
                                    CheckBox { text: root.tr("hint.custom"); checked <=> root.custom-mode; enabled: root.controls-ready && root.full-features && !root.device-active; }
                                    if !root.custom-mode: ComboBox { model: root.model-presets; current-index <=> root.model-idx; width: 320px; enabled: root.controls-ready && root.full-features && !root.device-active; }
                                    if root.custom-mode: LineEdit { text <=> root.custom-model-input; placeholder-text: root.tr("hint.model.code"); width: 320px; enabled: root.controls-ready && root.full-features && !root.device-active; }
                                    Button {
                                        height: 30px; width: 80px; primary: true; text: root.tr("btn.apply"); enabled: root.controls-ready && root.full-features && !root.device-active;
                                        clicked => {
                                            if root.custom-mode { root.apply-device(root.custom-model-input); }
                                            else { root.apply-device(root.model-codes[root.model-idx]); }
                                        }
                                    }
                                    Button { height: 30px; width: 80px; text: root.tr("btn.revert"); enabled: root.controls-ready && root.full-features && root.device-active; clicked => { root.revert-device(); } }
                                }
                            }

                            HorizontalLayout {
                                min-height: 40px;
                                spacing: 10px;
                                Text { text: root.tr("patch.camera"); vertical-alignment: center; min-width: 150px; preferred-width: 150px; max-width: 150px; font-size: 16px; }
                                HorizontalLayout {
                                    alignment: end;
                                    spacing: 6px;
                                    Button { height: 30px; width: 80px; primary: true; text: root.tr("btn.apply"); enabled: root.controls-ready && root.full-features && !root.camera-active; clicked => { root.apply-camera(); } }
                                    Button { height: 30px; width: 80px; text: root.tr("btn.revert"); enabled: root.controls-ready && root.full-features && root.camera-active; clicked => { root.revert-camera(); } }
                                }
                            }

                            HorizontalLayout {
                                min-height: 40px;
                                spacing: 10px;
                                Text { text: root.tr("patch.audio"); vertical-alignment: center; min-width: 150px; preferred-width: 150px; max-width: 150px; font-size: 16px; }
                                HorizontalLayout {
                                    alignment: end;
                                    spacing: 6px;
                                    Button { height: 30px; width: 80px; primary: true; text: root.tr("btn.wifi"); enabled: root.controls-ready && root.full-features && (!root.audio-active || root.audio-mode != 1); clicked => { root.apply-audio-wifi(); } }
                                    Button { height: 30px; width: 80px; primary: true; text: root.tr("btn.lan"); enabled: root.controls-ready && root.full-features && (!root.audio-active || root.audio-mode != 2); clicked => { root.apply-audio-lan(); } }
                                    Button { height: 30px; width: 80px; text: root.tr("btn.revert"); enabled: root.controls-ready && root.full-features && root.audio-active; clicked => { root.revert-audio(); } }
                                }
                            }

                            HorizontalLayout {
                                min-height: 40px;
                                spacing: 10px;
                                Text { text: root.tr("patch.xiaoai"); vertical-alignment: center; min-width: 150px; preferred-width: 150px; max-width: 150px; font-size: 16px; }
                                HorizontalLayout {
                                    alignment: end;
                                    spacing: 6px;
                                    Button { height: 30px; width: 80px; primary: true; text: root.tr("btn.apply"); enabled: root.controls-ready && root.xiaoai-available && !root.xiaoai-busy && !root.xiaoai-patch-active; clicked => { root.apply-xiaoai(); } }
                                    Button { height: 30px; width: 80px; text: root.tr("btn.revert"); enabled: root.controls-ready && root.xiaoai-available && !root.xiaoai-busy && root.xiaoai-patch-active; clicked => { root.revert-xiaoai(); } }
                                }
                            }

                            HorizontalLayout {
                                min-height: 40px;
                                spacing: 10px;
                                Text { text: root.tr("patch.dual-nic"); vertical-alignment: center; min-width: 150px; preferred-width: 150px; max-width: 150px; font-size: 16px; }
                                HorizontalLayout {
                                    alignment: end;
                                    spacing: 6px;
                                    Button { height: 30px; width: 80px; text: root.tr("btn.diagnose"); enabled: root.controls-ready && root.full-features; clicked => { root.diagnose-dual-nic(); } }
                                    Button { height: 30px; width: 80px; primary: true; text: root.tr("btn.fix"); enabled: root.controls-ready && root.full-features && root.dual-nic-state == 2; clicked => { root.fix-dual-nic(); } }
                                }
                            }

                            HorizontalLayout {
                                min-height: 40px;
                                spacing: 10px;
                                Text { text: root.tr("patch.smbios"); vertical-alignment: center; min-width: 150px; preferred-width: 150px; max-width: 150px; font-size: 16px; }
                                HorizontalLayout {
                                    alignment: end;
                                    spacing: 6px;
                                    Button {
                                        height: 30px; width: 80px; primary: true; text: root.tr("btn.apply"); enabled: root.controls-ready && root.full-features && !root.smbios-active;
                                        clicked => {
                                            if root.custom-mode { root.apply-smbios(root.custom-model-input); }
                                            else { root.apply-smbios(root.model-codes[root.model-idx]); }
                                        }
                                    }
                                    Button { height: 30px; width: 80px; text: root.tr("btn.revert"); enabled: root.controls-ready && root.full-features && root.smbios-active; clicked => { root.revert-smbios(); } }
                                }
                            }

                            HorizontalLayout {
                                min-height: 40px;
                                spacing: 10px;
                                Text { text: root.tr("patch.share-menu"); vertical-alignment: center; min-width: 150px; preferred-width: 150px; max-width: 150px; font-size: 16px; }
                                HorizontalLayout {
                                    alignment: end;
                                    spacing: 6px;
                                    Button { height: 30px; width: 80px; primary: true; text: root.tr("btn.apply"); enabled: root.controls-ready && !root.share-menu-busy && root.share-menu-state != 1; clicked => { root.apply-xiaomi-share-menu(); } }
                                    Button { height: 30px; width: 80px; text: root.tr("btn.revert"); enabled: root.controls-ready && !root.share-menu-busy && root.share-menu-state != 0; clicked => { root.revert-xiaomi-share-menu(); } }
                                    if root.share-menu-busy: Spinner { indeterminate: true; }
                                }
                            }
                        }
                    }
                }
            }
        }
    }


    if root.show-confirm: Rectangle {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        background: #00000080;
        TouchArea { width: 100%; height: 100%; }

        VerticalLayout {
            width: 100%;
            height: 100%;
            alignment: center;
            HorizontalLayout {
                alignment: center;
                Rectangle {
                    background: Palette.background;
                    border-radius: 10px;
                    border-width: 1px;
                    border-color: Palette.border;
                    drop-shadow-blur: 16px;
                    drop-shadow-color: #00000040;
                    min-width: 380px;
                    VerticalLayout {
                        padding: 20px;
                        spacing: 16px;
                        Text { text: root.tr("section.confirm.uninstall"); font-size: 16px; font-weight: 700; }
                        Text { text: root.confirm-desc; font-size: 16px; }
                        HorizontalLayout {
                            alignment: end;
                            spacing: 8px;
                            Button { height: 30px; text: root.tr("btn.cancel"); clicked => { root.cancel-uninstall(); } }
                            Button { height: 30px; text: root.tr("btn.confirm"); primary: true; clicked => { root.confirm-uninstall(); } }
                        }
                    }
                }
            }
        }
    }
}
