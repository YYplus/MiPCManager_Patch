import {
    Button,
    LineEdit,
    TextEdit,
    ComboBox,
    Spinner,
    ScrollView,
    CheckBox,
    Palette,
} from "std-widgets.slint";

import "MiSans-Regular.ttf";

export component AppWindow inherits Window {
    title: "MiPCM Patch";
    icon: @image-url("MiPCManager.png");
    default-font-family: "MiSans";
    default-font-size: 14px;
    preferred-width: 1280px;
    preferred-height: 720px;
    min-width: 1100px;
    min-height: 720px;

    in-out property <string> status-text;
    in-out property <string> log-text;
    in-out property <bool> full-features: false;
    in-out property <bool> xiaoai-available: false;
    in-out property <string> last-error;
    in-out property <length> log-viewport-y: 0px;
    in-out property <bool> downloading: false;
    in-out property <bool> xiaoai-busy: false;
    in-out property <bool> manager-manual: false;
    in-out property <bool> xiaoai-manual: false;
    in-out property <[string]> manager-sources;
    in-out property <[string]> manager-requirements;
    in-out property <int> manager-source-idx: 0;
    in-out property <string> xiaoai-source;
    in-out property <float> manager-progress: 0;
    in-out property <string> manager-progress-text;
    in-out property <bool> manager-download-active: false;
    in-out property <float> xiaoai-progress: 0;
    in-out property <string> xiaoai-progress-text;
    in-out property <bool> xiaoai-download-active: false;
    in-out property <bool> show-confirm: false;
    in-out property <string> confirm-desc;
    in-out property <string> url-input;
    in-out property <string> path-input;
    in-out property <string> xiaoai-url-input;
    in-out property <string> xiaoai-path-input;
    in-out property <string> custom-model-input: "TM2425";
    in-out property <[string]> model-presets;
    in-out property <[string]> model-codes;
    in-out property <int> model-idx: 0;
    in-out property <bool> custom-mode: false;

    pure callback tr(string) -> string;

    callback refresh();
    callback apply-locale();
    callback revert-locale();
    callback apply-device(string);
    callback revert-device();
    callback apply-camera();
    callback revert-camera();
    callback apply-audio-wifi();
    callback apply-audio-lan();
    callback revert-audio();
    callback diagnose-dual-nic();
    callback fix-dual-nic();
    callback apply-smbios(string);
    callback revert-smbios();
    callback apply-xiaoai();
    callback revert-xiaoai();
    callback download-and-install(string);
    callback install-recommended();
    callback install-recommended-xiaoai();
    callback cancel-download();
    callback cancel-xiaoai-download();
    callback browse-installer();
    callback start-install(string);
    callback download-and-install-xiaoai(string);
    callback browse-xiaoai-installer();
    callback start-xiaoai-install(string);
    callback uninstall-msix();
    callback request-uninstall();
    callback confirm-uninstall();
    callback cancel-uninstall();
    callback clear-log();

    VerticalLayout {
        padding: 12px;
        spacing: 8px;

        HorizontalLayout {
            spacing: 8px;
            Text {
                text: root.tr("app.title");
                font-size: 24px;
                font-weight: 700;
                vertical-alignment: center;
            }

            HorizontalLayout {
                alignment: end;
                spacing: 6px;
                Button {
                    height: 30px;
                    width: 80px;
                    text: root.tr("btn.refresh");
                    clicked => { root.refresh(); }
                }
            }
        }

        HorizontalLayout {
            spacing: 12px;

            VerticalLayout {
                min-width: 320px;
                preferred-width: 360px;
                spacing: 10px;

                Rectangle {
                    border-radius: 10px;
                    border-width: 1px;
                    VerticalLayout {
                        padding: 16px;
                        spacing: 8px;
                        Text {
                            text: root.tr("section.status");
                            font-weight: 700;
                        }

                        TextEdit {
                            text <=> root.status-text;
                            read-only: true;
                            min-height: 60px;
                        }

                        if !root.full-features: Text {
                            text: root.tr("gui.warn.no_full");
                        }
                    }
                }

                Rectangle {
                    border-radius: 10px;
                    border-width: 1px;
                    VerticalLayout {
                        padding: 16px;
                        spacing: 8px;
                        HorizontalLayout {
                            Text {
                                text: root.tr("gui.log.title");
                                font-weight: 700;
                                font-size: 16px;
                                vertical-alignment: center;
                            }

                            HorizontalLayout {
                                alignment: end;
                                Button {
                                    height: 30px;
                                    width: 80px;
                                    text: root.tr("btn.clear-log");
                                    clicked => { root.clear-log(); }
                                }
                            }
                        }

                        if root.last-error != "": Text {
                            text: root.tr("gui.warn.recent_error") + root.last-error;
                            color: #dc3730;
                            font-size: 16px;
                        }
                        TextEdit {
                            text <=> root.log-text;
                            read-only: true;
                            min-height: 100px;
                            preferred-height: 200px;
                            viewport-y <=> root.log-viewport-y;
                        }
                    }
                }
            }

            ScrollView {
                VerticalLayout {
                    alignment: start;
                    spacing: 10px;

                    Rectangle {
                        border-radius: 10px;
                        border-width: 1px;
                        VerticalLayout {
                            padding: 16px;
                            spacing: 10px;
                            Text {
                                text: root.tr("section.patches");
                                font-weight: 700;
                                font-size: 16px;
                            }

                            HorizontalLayout {
                                spacing: 10px;
                                Text {
                                    text: root.tr("patch.locale");
                                    vertical-alignment: center;
                                    min-width: 90px;
                                    font-size: 16px;
                                }

                                HorizontalLayout {
                                    spacing: 6px;
                                    Button {
                                        height: 30px;
                                        width: 80px;
                                        primary: true;
                                        text: root.tr("btn.apply");
                                        clicked => { root.apply-locale(); }
                                    }

                                    Button {
                                        height: 30px;
                                        width: 80px;
                                        text: root.tr("btn.revert");
                                        clicked => { root.revert-locale(); }
                                    }
                                }
                            }

                            HorizontalLayout {
                                spacing: 10px;
                                Text {
                                    text: root.tr("patch.device");
                                    vertical-alignment: center;
                                    min-width: 90px;
                                    font-size: 16px;
                                }

                                HorizontalLayout {
                                    spacing: 6px;
                                    alignment: end;
                                    CheckBox {
                                        text: root.tr("hint.custom");
                                        checked <=> root.custom-mode;
                                    }
                                    if !root.custom-mode: ComboBox {
                                        model: root.model-presets;
                                        current-index <=> root.model-idx;
                                        width: 320px;
                                    }
                                    if root.custom-mode: LineEdit {
                                        text <=> root.custom-model-input;
                                        placeholder-text: root.tr("hint.model.code");
                                        width: 320px;
                                    }

                                    Button {
                                        height: 30px;
                                        width: 80px;
                                        primary: true;
                                        text: root.tr("btn.apply");
                                        enabled: root.full-features;
                                        clicked => {
                                             if root.custom-mode {
                                                 root.apply-device(root.custom-model-input);
                                             } else {
                                                 root.apply-device(root.model-codes[root.model-idx]);
                                             }
                                         }
                                    }

                                    Button {
                                        height: 30px;
                                        width: 80px;
                                        text: root.tr("btn.revert");
                                        enabled: root.full-features;
                                        clicked => { root.revert-device(); }
                                    }
                                }
                            }

                            HorizontalLayout {
                                spacing: 10px;
                                Text {
                                    text: root.tr("patch.camera");
                                    vertical-alignment: center;
                                    min-width: 90px;
                                    font-size: 16px;
                                }

                                HorizontalLayout {
                                    spacing: 6px;
                                    Button {
                                        height: 30px;
                                        width: 80px;
                                        primary: true;
                                        text: root.tr("btn.apply");
                                        enabled: root.full-features;
                                        clicked => { root.apply-camera(); }
                                    }

                                    Button {
                                        height: 30px;
                                        width: 80px;
                                        text: root.tr("btn.revert");
                                        enabled: root.full-features;
                                        clicked => { root.revert-camera(); }
                                    }
                                }
                            }

                            HorizontalLayout {
                                spacing: 10px;
                                Text {
                                    text: root.tr("patch.audio");
                                    vertical-alignment: center;
                                    min-width: 90px;
                                    font-size: 16px;
                                }

                                HorizontalLayout {
                                    spacing: 6px;
                                    Button {
                                        height: 30px;
                                        width: 80px;
                                        primary: true;
                                        text: root.tr("btn.wifi");
                                        enabled: root.full-features;
                                        clicked => { root.apply-audio-wifi(); }
                                    }

                                    Button {
                                        height: 30px;
                                        width: 80px;
                                        primary: true;
                                        text: root.tr("btn.lan");
                                        enabled: root.full-features;
                                        clicked => { root.apply-audio-lan(); }
                                    }

                                    Button {
                                        height: 30px;
                                        width: 80px;
                                        text: root.tr("btn.revert");
                                        enabled: root.full-features;
                                        clicked => { root.revert-audio(); }
                                    }
                                }
                            }

                            HorizontalLayout {
                                spacing: 10px;
                                Text {
                                    text: root.tr("patch.xiaoai");
                                    vertical-alignment: center;
                                    min-width: 90px;
                                    font-size: 16px;
                                }

                                HorizontalLayout {
                                    spacing: 6px;
                                    Button {
                                        height: 30px;
                                        width: 80px;
                                        primary: true;
                                        text: root.tr("btn.apply");
                                        enabled: root.xiaoai-available && !root.xiaoai-busy;
                                        clicked => { root.apply-xiaoai(); }
                                    }

                                    Button {
                                        height: 30px;
                                        width: 80px;
                                        text: root.tr("btn.revert");
                                        enabled: root.xiaoai-available && !root.xiaoai-busy;
                                        clicked => { root.revert-xiaoai(); }
                                    }
                                }
                            }

                            HorizontalLayout {
                                spacing: 10px;
                                Text {
                                    text: root.tr("patch.dual-nic");
                                    vertical-alignment: center;
                                    min-width: 90px;
                                    font-size: 16px;
                                }

                                HorizontalLayout {
                                    spacing: 6px;
                                    Button {
                                        height: 30px;
                                        width: 80px;
                                        text: root.tr("btn.diagnose");
                                        enabled: root.full-features;
                                        clicked => { root.diagnose-dual-nic(); }
                                    }

                                    Button {
                                        height: 30px;
                                        width: 80px;
                                        primary: true;
                                        text: root.tr("btn.fix");
                                        enabled: root.full-features;
                                        clicked => { root.fix-dual-nic(); }
                                    }
                                }
                            }

                            HorizontalLayout {
                                spacing: 10px;
                                Text {
                                    text: root.tr("patch.smbios");
                                    vertical-alignment: center;
                                    min-width: 90px;
                                    font-size: 16px;
                                }

                                HorizontalLayout {
                                    spacing: 6px;
                                    Button {
                                        height: 30px;
                                        width: 80px;
                                        primary: true;
                                        text: root.tr("btn.apply");
                                        enabled: root.full-features;
                                        clicked => {
                                             if root.custom-mode {
                                                 root.apply-smbios(root.custom-model-input);
                                             } else {
                                                 root.apply-smbios(root.model-codes[root.model-idx]);
                                             }
                                         }
                                    }

                                    Button {
                                        height: 30px;
                                        width: 80px;
                                        text: root.tr("btn.revert");
                                        enabled: root.full-features;
                                        clicked => { root.revert-smbios(); }
                                    }
                                }
                            }
                        }
                    }

                    Rectangle {
                        border-radius: 10px;
                        border-width: 1px;
                        VerticalLayout {
                            padding: 16px;
                            spacing: 8px;
                            Text {
                                text: root.tr("install.title");
                                font-weight: 700;
                                font-size: 16px;
                            }

                            ComboBox {
                                model: root.manager-sources;
                                current-index <=> root.manager-source-idx;
                                enabled: !root.downloading;
                            }
                            Text {
                                text: root.manager-requirements[root.manager-source-idx];
                                wrap: word-wrap;
                            }
                            HorizontalLayout {
                                spacing: 6px;
                                Button {
                                    height: 30px;
                                    width: 166px;
                                    primary: true;
                                    text: root.tr("install.one-click");
                                    enabled: !root.downloading;
                                    clicked => { root.install-recommended(); }
                                }
                                Button {
                                    height: 30px;
                                    text: root.manager-manual ? root.tr("install.hide-manual") : root.tr("install.manual");
                                    enabled: !root.downloading;
                                    clicked => { root.manager-manual = !root.manager-manual; }
                                }
                                if root.downloading: Spinner { indeterminate: true; }
                            }

                            if root.downloading: VerticalLayout {
                                spacing: 6px;
                                Rectangle {
                                    height: 6px;
                                    background: Palette.alternate-background;
                                    Rectangle {
                                        width: parent.width * root.manager-progress;
                                        background: Palette.accent-background;
                                    }
                                }
                                Text { text: root.manager-progress-text; }
                                Button {
                                    height: 30px;
                                    text: root.tr("install.cancel-download");
                                    enabled: root.manager-download-active;
                                    clicked => { root.cancel-download(); }
                                }
                            }

                            if root.manager-manual: VerticalLayout {
                                spacing: 6px;
                                HorizontalLayout {
                                    spacing: 6px;
                                    LineEdit {
                                        text <=> root.url-input;
                                        enabled: !root.downloading;
                                        placeholder-text: root.tr("install.download.placeholder");
                                    }
                                    Button {
                                        height: 30px;
                                        width: 166px;
                                        primary: true;
                                        text: root.tr("install.download.and.install");
                                        enabled: !root.downloading && root.url-input != "";
                                        clicked => { root.download-and-install(root.url-input); }
                                    }
                                }
                                HorizontalLayout {
                                    spacing: 6px;
                                    LineEdit {
                                        text <=> root.path-input;
                                        enabled: !root.downloading;
                                        placeholder-text: root.tr("install.file.placeholder");
                                    }
                                    Button {
                                        height: 30px;
                                        width: 80px;
                                        text: root.tr("btn.select");
                                        enabled: !root.downloading;
                                        clicked => { root.browse-installer(); }
                                    }
                                    Button {
                                        height: 30px;
                                        width: 80px;
                                        primary: true;
                                        text: root.tr("btn.start-install");
                                        enabled: !root.downloading && root.path-input != "";
                                        clicked => { root.start-install(root.path-input); }
                                    }
                                }
                            }
                        }
                    }

                    Rectangle {
                        border-radius: 10px;
                        border-width: 1px;
                        VerticalLayout {
                            padding: 16px;
                            spacing: 8px;
                            Text {
                                text: root.tr("install.xiaoai.title");
                                font-weight: 700;
                                font-size: 16px;
                            }
                            Text {
                                text: root.tr("install.xiaoai.note");
                                wrap: word-wrap;
                            }
                            Text { text: root.xiaoai-source; }
                            HorizontalLayout {
                                spacing: 6px;
                                Button {
                                    height: 30px;
                                    width: 166px;
                                    primary: true;
                                    text: root.tr("install.one-click");
                                    enabled: !root.xiaoai-busy;
                                    clicked => { root.install-recommended-xiaoai(); }
                                }
                                Button {
                                    height: 30px;
                                    text: root.xiaoai-manual ? root.tr("install.hide-manual") : root.tr("install.manual");
                                    enabled: !root.xiaoai-busy;
                                    clicked => { root.xiaoai-manual = !root.xiaoai-manual; }
                                }
                                if root.xiaoai-busy: Spinner { indeterminate: true; }
                            }
                            if root.xiaoai-busy: VerticalLayout {
                                spacing: 6px;
                                Rectangle {
                                    height: 6px;
                                    background: Palette.alternate-background;
                                    Rectangle {
                                        width: parent.width * root.xiaoai-progress;
                                        background: Palette.accent-background;
                                    }
                                }
                                Text { text: root.xiaoai-progress-text; }
                                Button {
                                    height: 30px;
                                    text: root.tr("install.cancel-download");
                                    enabled: root.xiaoai-download-active;
                                    clicked => { root.cancel-xiaoai-download(); }
                                }
                            }
                            if root.xiaoai-manual: VerticalLayout {
                                spacing: 6px;
                                HorizontalLayout {
                                    spacing: 6px;
                                    LineEdit {
                                        text <=> root.xiaoai-url-input;
                                        enabled: !root.xiaoai-busy;
                                        placeholder-text: root.tr("install.download.placeholder");
                                    }
                                    Button {
                                        height: 30px;
                                        width: 166px;
                                        primary: true;
                                        text: root.tr("install.download.and.install");
                                        enabled: !root.xiaoai-busy && root.xiaoai-url-input != "";
                                        clicked => { root.download-and-install-xiaoai(root.xiaoai-url-input); }
                                    }
                                }
                                HorizontalLayout {
                                    spacing: 6px;
                                    LineEdit {
                                        text <=> root.xiaoai-path-input;
                                        enabled: !root.xiaoai-busy;
                                        placeholder-text: root.tr("install.file.placeholder");
                                    }
                                    Button {
                                        height: 30px;
                                        width: 80px;
                                        text: root.tr("btn.select");
                                        enabled: !root.xiaoai-busy;
                                        clicked => { root.browse-xiaoai-installer(); }
                                    }
                                    Button {
                                        height: 30px;
                                        width: 80px;
                                        primary: true;
                                        text: root.tr("btn.start-install");
                                        enabled: !root.xiaoai-busy && root.xiaoai-path-input != "";
                                        clicked => { root.start-xiaoai-install(root.xiaoai-path-input); }
                                    }
                                }
                            }
                        }
                    }

                    Rectangle {
                        border-radius: 10px;
                        border-width: 1px;
                        VerticalLayout {
                            padding: 16px;
                            spacing: 8px;
                            Text {
                                text: root.tr("section.uninstall");
                                font-weight: 700;
                                font-size: 16px;
                            }

                            HorizontalLayout {
                                spacing: 6px;
                                Button {
                                    height: 30px;
                                    text: root.tr("gui.uninstall.msix");
                                    clicked => { root.uninstall-msix(); }
                                }

                                Button {
                                    height: 30px;
                                    text: root.tr("gui.uninstall.product");
                                    clicked => { root.request-uninstall(); }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    if root.show-confirm: Rectangle {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        background: #00000080;
        TouchArea {
            width: 100%;
            height: 100%;
        }

        VerticalLayout {
            width: 100%;
            height: 100%;
            alignment: center;
            HorizontalLayout {
                alignment: center;
                Rectangle {
                    background: Palette.background;
                    border-radius: 10px;
                    border-width: 1px;
                    border-color: Palette.border;
                    drop-shadow-blur: 16px;
                    drop-shadow-color: #00000040;
                    min-width: 380px;
                    VerticalLayout {
                        padding: 20px;
                        spacing: 16px;
                        Text {
                            text: root.tr("section.confirm.uninstall");
                            font-size: 16px;
                            font-weight: 700;
                        }

                        Text {
                            text: root.confirm-desc;
                            font-size: 16px;
                        }

                        HorizontalLayout {
                            alignment: end;
                            spacing: 8px;
                            Button {
                                height: 30px;
                                text: root.tr("btn.cancel");
                                clicked => { root.cancel-uninstall(); }
                            }

                            Button {
                                height: 30px;
                                text: root.tr("btn.confirm");
                                primary: true;
                                clicked => { root.confirm-uninstall(); }
                            }
                        }
                    }
                }
            }
        }
    }
}
